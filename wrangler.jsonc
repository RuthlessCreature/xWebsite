{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xiaodu-intelligent-website",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-30",
  "routes": [
    {
      "pattern": "xiaodu.tech/*",
      "zone_name": "xiaodu.tech"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/zh-cn/*",
      "/zh-tw/*",
      "/en/*",
      "/ja/*",
      "/es/*",
      "/pt/*",
      "/ru/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  }
}
